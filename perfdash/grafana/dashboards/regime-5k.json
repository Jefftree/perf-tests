        "definition": "label_values(perfdash_value, prefix)",
        "includeAll": false,
        "label": "Node count / job",
        "name": "node",
        "options": [],
        "query": { "qryType": 1, "query": "label_values(perfdash_value, prefix)", "refId": "VictoriaMetrics-node-Variable-Query" },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
